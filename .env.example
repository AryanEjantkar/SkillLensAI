# Google Gemini API Key (Required for Gemma 4 access)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemma Model ID (defaults to gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Application Port (Optional, defaults to 3000)
PORT=3000
